{
  // Cloudflare Workers deployment config for Bleach Arena.
  // `bun run build` emits the Worker entry at dist/server/index.mjs and the
  // static client bundle at dist/client — this file points Wrangler at both so
  // `npx wrangler deploy` never tries to re-scaffold the project.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bleacharena",
  "main": "dist/server/index.mjs",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
